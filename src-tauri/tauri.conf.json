{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VRCText",
  "version": "0.2.0",
  "identifier": "dev.vrctext",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VRCText",
        "width": 460,
        "height": 340,
        "minWidth": 380,
        "minHeight": 240,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "center": true,
        "alwaysOnTop": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
